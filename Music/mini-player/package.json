{
    "name": "mini-player",
    "version": "0.1.0",
    "description": "Mini player for Apple Music on Windows (Electron)",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "make-icon": "node tools/generate-icon.js"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "electron": "latest",
        "electron-builder": "^23.6.0"
    },
    "build": {
        "appId": "com.example.applemusicminiplayer",
        "productName": "Mini Player",
        "files": [
            "**/*"
        ],
        "directories": {
            "buildResources": "assets"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "assets/icon.svg"
        }
    },
    "dependencies": {
        "jimp": "^1.6.1",
        "pureimage": "^0.4.20",
        "to-ico": "^1.1.5"
    }
}
